# Production build values — used automatically by `npm run build`.
# Keys set here override .env; everything not listed falls through.

VITE_API_URL=https://mintsites.co.uk/

# Admin panel — NOTE: this name also becomes the admin URL slug
# (lowercased, see src/config.js), and must match the backend's ADMIN_SLUG.
# Keep it a single word.
VITE_MODULE_ADMIN_NAME=Peppermint
VITE_MODULE_ADMIN_DASHBOARD_NAME=Dashboard

# Demo mode — mintsites.co.uk IS the demo/sales site, so this stays on.
VITE_DEMO_MODE=true

# Maintenance mode
VITE_MAINTENANCE_MODE=false
VITE_MAINTENANCE_BYPASS=false

# Neutralise legacy localhost values from .env (unused in src, but baked
# into the bundle otherwise)
VUE_APP_API_ENDPOINT=
VITE_API_URL_FOR_STORAGE=
VITE_API_ASSET_URL=
VITE_API_DEFAULT_IMAGE=

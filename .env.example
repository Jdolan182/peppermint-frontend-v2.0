VITE_API_URL=http://localhost/

# Admin panel
VITE_MODULE_ADMIN_NAME=Peppermint
VITE_MODULE_ADMIN_DASHBOARD_NAME=Dashboard

# Modules — set to 'true' to enable
VITE_MODULE_ADMIN=true
VITE_MODULE_PUBLIC=true
VITE_MODULE_PUBLIC_LOGIN=true
VITE_MODULE_CONSUMERS=true
VITE_MODULE_TEAM=true
VITE_MODULE_SETTINGS=true
VITE_MODULE_BLOGS=true
VITE_MODULE_PAGES=true
VITE_MODULE_TASKS=true
VITE_MODULE_ROADMAP=true

# Maintenance mode
# Set VITE_MAINTENANCE_BYPASS=true to show the password form on the maintenance page.
# The actual bypass password is set server-side as MAINTENANCE_BYPASS_PASSWORD in the backend .env.
VITE_MAINTENANCE_MODE=false
VITE_MAINTENANCE_BYPASS=false
